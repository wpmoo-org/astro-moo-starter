---
import type { GetStaticPathsOptions } from "astro";
import type { RootPath } from "@wpmoo/astro/context";
import Page from "../../../../src/views/Page.astro";
import Taxonomy from "../../../../src/views/Taxonomy.astro";
import { getSiteRootPaths } from "../../../../src/routes.js";
type Props = RootPath["props"];
export const prerender = true;
export function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  return getSiteRootPaths(routePattern);
}
const props = Astro.props;
---

{props.kind === "page" ? <Page entry={props.entry} /> : <Taxonomy {...props} />}
