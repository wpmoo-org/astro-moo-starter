---
import type { GetStaticPathsOptions } from "astro";
import type { TaxonomyPath } from "@wpmoo/astro/taxonomies/queries";
import Taxonomy from "../../../../src/views/Taxonomy.astro";
import { getSiteTaxonomyPaths } from "../../../../src/routes.js";
type Props = TaxonomyPath["props"];
export const prerender = true;
export function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  return getSiteTaxonomyPaths(routePattern);
}
---

<Taxonomy {...Astro.props} />
