---
import Layout from "../layouts/Layout.astro";
import Archive from "@wpmoo/astro/views/Archive.astro";
import { resolvePageOptions } from "@wpmoo/astro/config";
import { getSiteContext, getEntryHref } from "@wpmoo/astro/context";
import { getLocaleHref } from "@wpmoo/astro/i18n";
import { getPublishedPosts } from "@wpmoo/astro/plugins/post/queries";
import { resolveSeoMetadata } from "@wpmoo/astro/seo";
import { entryContext } from "../routes.js";
import { getChrome } from "../navigation.js";
import { getMessages } from "../messages.js";
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const { site, plugins, i18n } = getSiteContext();
const post = plugins.find((plugin) => plugin.id === "post")!;
const hrefFor = (lang: string) =>
  getLocaleHref(post.locales?.[lang]?.basePath ?? post.basePath, lang);
const title = getMessages(locale).posts;
const options = resolvePageOptions(site, "post", "archive", undefined, locale);
const entries = await getPublishedPosts({ locale });
const items = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  href: getEntryHref("post", entry),
  date: entry.data.published_at,
  entryContext: entryContext("post", entry),
}));
const languageLinks = i18n!.locales.map((lang) => ({
  locale: lang,
  href: hrefFor(lang),
}));
const chrome = await getChrome(hrefFor(locale), locale, title, languageLinks);
const metadata = resolveSeoMetadata(site, {
  title,
  status: "publish",
  type: "post",
  view: "archive",
  lang: locale,
  url: new URL(hrefFor(locale), Astro.site).href,
  alternates: languageLinks.map((link) => ({
    locale: link.locale,
    url: new URL(link.href, Astro.site).href,
  })),
});
---

<Layout
  title={title}
  options={options}
  chrome={chrome}
  metadata={metadata}
  pageContext={{ view: "archive", type: "post" }}
  ><Archive
    title={title}
    parts={options.parts}
    lang={options.lang}
    items={items}
  /></Layout
>
