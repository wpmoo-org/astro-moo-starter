---
import Layout from "../layouts/Layout.astro";
import Archive from "@wpmoo/astro/views/Archive.astro";
import { resolvePageOptions } from "@wpmoo/astro/config";
import { getSiteContext } from "@wpmoo/astro/context";
import { resolveSeoMetadata } from "@wpmoo/astro/seo";
import type { TaxonomyPath } from "@wpmoo/astro/taxonomies/queries";
import { getChrome } from "../navigation.js";
type Props = TaxonomyPath["props"];
const { taxonomy, term, href, items, locale, alternates = [] } = Astro.props;
const { site } = getSiteContext();
const lang = locale ?? site.defaults.lang;
const options = resolvePageOptions(site, taxonomy, "archive", undefined, lang);
const chrome = await getChrome(href, lang, term.name, alternates);
const metadata = resolveSeoMetadata(site, {
  title: term.name,
  description: term.description,
  status: "publish",
  type: taxonomy,
  view: "archive",
  lang,
  url: new URL(href, Astro.site).href,
  alternates: alternates.map((link) => ({
    locale: link.locale,
    url: new URL(link.href, Astro.site).href,
  })),
});
---

<Layout
  title={term.name}
  description={term.description}
  options={options}
  chrome={chrome}
  metadata={metadata}
  pageContext={{ view: "taxonomy", taxonomy, term: term.id }}
  ><Archive
    title={term.name}
    description={term.description}
    parts={options.parts}
    lang={options.lang}
    items={[...items]}
  /></Layout
>
