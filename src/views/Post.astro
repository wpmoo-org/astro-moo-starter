---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Post from "@wpmoo/astro/views/Single.astro";
import { resolvePageOptions, formatDate } from "@wpmoo/astro/config";
import { getEntryHref, getSiteContext } from "@wpmoo/astro/context";
import { getLanguageLinks } from "@wpmoo/astro/i18n";
import { resolveSeoMetadata } from "@wpmoo/astro/seo";
import { getTaxonomyPaths } from "@wpmoo/astro/taxonomies/queries";
import EntryTaxonomies from "../components/EntryTaxonomies.astro";
import { groupTaxonomyLinks, entryTaxonomyGroups } from "../taxonomy-links.js";
import { getMessages } from "../messages.js";
import { entryContext } from "../routes.js";
import { getChrome } from "../navigation.js";
interface Props {
  entry: CollectionEntry<"post">;
}
const { entry } = Astro.props;
const { site, taxonomies } = getSiteContext();
const locale = entry.data.locale ?? site.defaults.lang;
const options = resolvePageOptions(
  site,
  "post",
  "single",
  entry.data.options,
  locale,
);
const href = getEntryHref("post", entry);
const languageLinks = await getLanguageLinks("post", entry);
const taxonomyGroups = groupTaxonomyLinks(
  taxonomies,
  await getTaxonomyPaths({ locale }),
  locale,
);
const chrome = await getChrome(
  href,
  locale,
  entry.data.title,
  languageLinks,
  taxonomyGroups,
);
const metadata = resolveSeoMetadata(site, {
  title: entry.data.title,
  description: entry.data.description,
  status: entry.data.status,
  created_at: entry.data.created_at,
  published_at: entry.data.published_at,
  updated_at: entry.data.updated_at,
  type: "post",
  view: "single",
  lang: locale,
  url: new URL(href, Astro.site).href,
  alternates: languageLinks.map((link) => ({
    locale: link.locale,
    url: new URL(link.href, Astro.site).href,
  })),
});
const context = entryContext("post", entry);
const date = entry.data.published_at;
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  options={options}
  chrome={chrome}
  metadata={metadata}
  pageContext={{ view: "single", entry: context }}
>
  <Post
    title={entry.data.title}
    description={entry.data.description}
    parts={options.parts}
    entryContext={context}
  >
    {
      date ? (
        <time datetime={date.toISOString()}>
          {formatDate(date, {
            lang: options.lang,
            style: options.parts.loop.dateStyle,
          })}
        </time>
      ) : null
    }
    <EntryTaxonomies
      groups={entryTaxonomyGroups(context, taxonomyGroups)}
      label={getMessages(locale).taxonomies}
    />
    <Content />
  </Post>
</Layout>
