---
import Layout from "../layouts/Layout.astro";
import NotFound from "@wpmoo/astro/views/NotFound.astro";
import { getNotFoundOptions } from "@wpmoo/astro/not-found";
interface Props {
  locale?: string;
}
const data = getNotFoundOptions(Astro.props.locale);
const chrome = {
  locale: data.locale,
  brand: data.brand,
  homeHref: data.homeHref,
  languageLinks: data.languageLinks,
  breadcrumbs: [
    { label: data.brand, href: data.homeHref },
    { label: data.title },
  ],
  navigation: [{ items: [{ title: data.homeLabel, href: data.homeHref }] }],
};
---

<Layout
  title={data.title}
  description={data.description}
  options={data.options}
  chrome={chrome}
  metadata={null}
  pageContext={{ view: "native", key: "not-found" }}
  ><NotFound {...data} parts={data.options.parts} /></Layout
>
