---
import Layout from "@wpmoo/astro/Layout.astro";
import Header from "@wpmoo/astro/includes/Header.astro";
import Footer from "@wpmoo/astro/includes/Footer.astro";
import Sidebar from "@wpmoo/astro/includes/Sidebar.astro";
import LanguageSwitcher from "@wpmoo/astro/blocks/LanguageSwitcher.astro";
import { getMessages } from "../messages.js";
import type { SiteLayoutProps } from "../types.js";
type Props = SiteLayoutProps;
const { chrome, options, title, description, metadata, pageContext } =
  Astro.props;
const { sidebar, ...layout } = options;
const { defaultOpen, ...sidebarProps } = sidebar ?? {};
const locale = chrome.locale;
---

<Layout
  {...layout}
  title={title}
  description={description}
  metadata={metadata}
  pageContext={pageContext}
  sidebar={sidebar !== null}
  defaultOpen={defaultOpen}
  sidebarId="starter-sidebar"
  sidebarKey="astro-moo-starter"
>
  {
    sidebar ? (
      <Sidebar
        slot="sidebar"
        {...sidebarProps}
        id="starter-sidebar"
        brand={chrome.brand}
        brandHref={chrome.homeHref}
        groups={[...chrome.navigation]}
        parts={options.parts}
      />
    ) : null
  }
  <Header
    slot="header"
    breadcrumbs={[...chrome.breadcrumbs]}
    parts={options.parts}
  >
    <LanguageSwitcher
      slot="actions"
      links={chrome.languageLinks}
      currentLocale={locale}
      label={getMessages(locale).language}
      menuLabel={getMessages(locale).selectLanguage}
      languageNames={{ en: "English", de: "Deutsch" }}
      class="ms-auto flex-shrink-0"
    />
  </Header>
  <slot />
  <Footer
    slot="footer"
    brand={chrome.brand}
    homeHref={chrome.homeHref}
    parts={options.parts}
  />
</Layout>
