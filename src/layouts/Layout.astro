---
import Layout from "@wpmoo/astro/Layout.astro";
import Header from "@wpmoo/astro/includes/Header.astro";
import Footer from "@wpmoo/astro/includes/Footer.astro";
import Sidebar from "@wpmoo/astro/includes/Sidebar.astro";
import Button from "@wpmoo/astro/components/Button.astro";
import type { SiteLayoutProps } from "../types.js";
type Props = SiteLayoutProps;
const { chrome, options, title, description, metadata, pageContext } =
  Astro.props;
const { sidebar, ...layout } = options;
const { defaultOpen, ...sidebarProps } = sidebar ?? {};
---

<Layout
  {...layout}
  title={title}
  description={description}
  metadata={metadata}
  pageContext={pageContext}
  sidebar={sidebar !== null}
  defaultOpen={defaultOpen}
  sidebarId="starter-sidebar"
  sidebarKey="astro-moo-starter"
>
  {
    sidebar ? (
      <Sidebar
        slot="sidebar"
        {...sidebarProps}
        id="starter-sidebar"
        brand={chrome.brand}
        brandHref={chrome.homeHref}
        groups={[...chrome.navigation]}
        parts={options.parts}
      />
    ) : null
  }
  <Header
    slot="header"
    breadcrumbs={[...chrome.breadcrumbs]}
    parts={options.parts}
  >
    <Fragment slot="actions">
      {
        chrome.languageLinks.map(({ locale, href }) => (
          <Button element="a" href={href} label={locale.toUpperCase()} />
        ))
      }
    </Fragment>
  </Header>
  <slot />
  <Footer
    slot="footer"
    brand={chrome.brand}
    homeHref={chrome.homeHref}
    parts={options.parts}
  />
</Layout>
