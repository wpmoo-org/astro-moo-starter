---
import type { TaxonomyLinkGroup } from "../taxonomy-links.js";
interface Props {
  groups: readonly TaxonomyLinkGroup[];
  label: string;
}
const { groups, label } = Astro.props;
---

{
  groups.length > 0 && (
    <dl data-entry-taxonomies aria-label={label}>
      {groups.map((group) => (
        <Fragment>
          <dt>{group.label}</dt>
          <dd data-taxonomy={group.id}>
            {group.links.map((link, index) => (
              <Fragment>
                {index > 0 ? ", " : ""}
                <a href={link.href} rel="tag">
                  {link.label}
                </a>
              </Fragment>
            ))}
          </dd>
        </Fragment>
      ))}
    </dl>
  )
}
